# Packages come through the company Artifactory: a remote repository of Broadcom TrueSource.
# The token is never written here. CI writes it to a user .npmrc outside the repository;
# locally, run: npm config set //kuhnlabs.jfrog.io/artifactory/api/npm/truesource-npm/:_authToken <token>
registry=https://kuhnlabs.jfrog.io/artifactory/api/npm/truesource-npm/
