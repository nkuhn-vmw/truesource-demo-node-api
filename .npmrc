# Packages come through the company Artifactory: the virtual repository "npm" asks the Broadcom
# TrueSource remote first and falls back to npmjs for what TrueSource does not carry.
# The build-info of each CI build tells which dependency came from where.
# The token is never written here. CI writes it to a user .npmrc outside the repository;
# locally, run: npm config set //kuhnlabs.jfrog.io/artifactory/api/npm/npm/:_authToken <token>
registry=https://kuhnlabs.jfrog.io/artifactory/api/npm/npm/
